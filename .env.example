# ─── Contact Form (optional) ────────────────────────────────────────────────
# Fill these in to enable actual email delivery from the contact form.
# Without them, submissions are logged to stdout (visible in Vercel dashboard).

# SMTP server host (e.g. smtp.gmail.com, smtp.sendgrid.net)
SMTP_HOST=

# SMTP port: 587 for TLS (recommended), 465 for SSL
SMTP_PORT=587

# Set to "true" if using port 465
SMTP_SECURE=false

# SMTP credentials (use an App Password for Gmail)
SMTP_USER=
SMTP_PASS=

# Where to deliver contact messages (defaults to SMTP_USER if omitted)
CONTACT_RECIPIENT=rudraksha127@gmail.com

# ─── Site URL ────────────────────────────────────────────────────────────────
# Used by robots.ts / sitemap.ts — update to your production domain.
NEXT_PUBLIC_SITE_URL=https://rudraksh.dev
